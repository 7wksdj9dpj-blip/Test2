local function CreateToggleButton(name, text, defaultState, onClick)
    local btn = Instance.new("TextButton")
    local corner = Instance.new("UICorner")
    local stroke = Instance.new("UIStroke")
    
    btn.Name = name
    btn.Parent = MainFrame
    btn.Size = UDim2.new(0.9, 0, 0, 28)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Active = true
    
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    stroke.Parent = btn
    stroke.Thickness = 1
    
    local function UpdateAppearence(state)
        if state then
            btn.Text = text .. " [ON]"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            stroke.Color = Color3.fromRGB(255, 40, 40)
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 20, 20)}):Play()
            btn.BackgroundTransparency = 0.1
        else
            btn.Text = text .. " [OFF]"
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            stroke.Color = Color3.fromRGB(40, 40, 40)
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}):Play()
            btn.BackgroundTransparency = 0.2
        end
    end
    
    UpdateAppearence(defaultState)
    btn.MouseButton1Click:Connect(function()
        local newState = onClick()
        UpdateAppearence(newState)
    end)
end

